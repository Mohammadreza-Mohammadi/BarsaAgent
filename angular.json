{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "barsa-agent": {
      "projectType": "application",
      "root": "client",
      "sourceRoot": "client/src",
      "prefix": "ba",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "client/src/main.ts",
            "index": "client/src/index.html",
            "tsConfig": "client/tsconfig.app.json",
            "styles": ["client/src/styles.css"],
            "outputPath": "dist/client"
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "900kB", "maximumError": "1.2MB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "development": { "buildTarget": "barsa-agent:build:development" } }, "defaultConfiguration": "development" }
      }
    }
  }
}
