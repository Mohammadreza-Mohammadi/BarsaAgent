{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(./barsa health:*)",
      "Bash(./barsa issues:*)",
      "Bash(./barsa tasks:*)",
      "Bash(./barsa task:*)",
      "Bash(./barsa log:*)",
      "Bash(./barsa waiting:*)",
      "Bash(./barsa --help)",
      "Bash(./barsa help)"
    ],
    "ask": [
      "Bash(./barsa create-from-issue:*)",
      "Bash(./barsa create-task:*)",
      "Bash(./barsa run:*)",
      "Bash(./barsa stop:*)",
      "Bash(./barsa answer:*)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read(//d/barsa-agent-data/**)",
      "Read(//d/BarsaAgent/.env.local)",
      "Read(//c/Users/Client01/.claude/**)",
      "Read(//c/Users/Client01/.ssh/**)",
      "Read(//c/Users/Client01/.git-credentials)",
      "Read(//c/Users/Client01/.npmrc)",
      "Read(//c/Users/Client01/AppData/**)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(cmd:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(python:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(cat:*)",
      "Bash(type:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(env:*)",
      "Bash(printenv:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node D:/agent-remote/guard.mjs" }
        ]
      }
    ]
  }
}
