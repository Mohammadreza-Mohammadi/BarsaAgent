{
  "name": "barsa-agent-console",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "ng serve --project barsa-agent --proxy-config client/proxy.conf.json",
    "build": "ng build --project barsa-agent --configuration production",
    "start": "node server/src/index.js",
    "test": "node --test server/test/*.test.js",
    "check:manager": "node server/check-manager.js"
  },
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@types/node": "^26.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
